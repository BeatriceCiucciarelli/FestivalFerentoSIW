<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Il parent di Spring Boot fornisce la "bill of materials": stabilisce
		le versioni compatibili di tutte le dipendenze, cosi' nei tag
		<dependency> qui sotto non serve mai indicare <version>.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>it.uniroma3</groupId>
	<artifactId>FestivalFerentoSIW</artifactId>
	<version>1.0</version>
	<name>FestivalFerentoSIW</name>
	<description>Progetto personale SIW 2025/2026 - biglietteria del Festival di Ferento</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>

		<!--
			PERSISTENZA
			Porta con se' JPA, Hibernate (implementazione di JPA) e
			Spring Data, che genera le implementazioni dei repository.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
			DRIVER POSTGRESQL
			scope=runtime: serve solo quando l'applicazione gira, non in
			compilazione (nel codice non nominiamo mai classi del driver,
			passiamo sempre per l'astrazione JDBC/JPA).
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			WEB MVC
			Controller, gestione delle richieste HTTP e server Tomcat
			incorporato.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			THYMELEAF
			Motore di template lato server per le pagine HTML.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!--
			SICUREZZA
			Autenticazione e autorizzazione (login, ruoli USER/ADMIN,
			BCrypt per le password, protezione CSRF).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			INTEGRAZIONE THYMELEAF <-> SECURITY
			Abilita nei template gli attributi sec:authorize e
			sec:authentication (es. mostrare il link "Logout" solo a chi
			ha gia' effettuato l'accesso). Non e' inclusa nello starter
			di security: va aggiunta a mano.
		-->
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<!--
			VALIDAZIONE
			Bean Validation: abilita @NotBlank, @Min, @Size... sulle
			entita' e il controllo automatico con @Valid nei controller.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ===================== TEST ===================== -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>